~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to the tool command
----------------------------------------------------------------------------------------
*/

process {

    // Deacon index build -- only runs when --fasta is supplied
    withName: 'GENERATE_IDX' {
        ext.args = { params.deacon_index_args ?: '' }
    }

    // Deacon filter -- depletion (-d) and extraction share the same args so the
    // depleted and reference-only outputs remain exact complements
    withName: 'SINGLE_REFERENCE_REMOVAL|SINGLE_SAMPLE_REMOVAL|PAIRED_REFERENCE_REMOVAL|PAIRED_SAMPLE_REMOVAL' {
        ext.args = { params.deacon_filter_args ?: '' }
    }

}